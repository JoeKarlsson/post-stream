{
  "name": "postStream",
  "author": "Jacoby Young, Ray Farias and Joe Karlsson",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "PostStream is an undesigned social network. It is a text-based response to the majority of modern social media platforms. This is certainly not for everyone as you will be interacting with others exclusively through text posts. You will notice several features intentionally left out in order to promote meaningful engagement. We hope you enjoy something a little different!",
  "keywords": [
    "social network",
    "Text",
    "PostStream",
    "Post",
    "Stream",
    "Social Media",
    "meaningful engagement",
    "Minimal",
    "undesigned",
    "text-based",
    "redux",
    "react-redux",
    "markdown",
    "text",
    "react",
    "express"
  ],
  "license": "MIT",
  "homepage": "https://poststream.joekarlsson.com",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"vite\" \"NODE_ENV=development node --watch server/server.js\"",
    "dev:client": "vite",
    "dev:server": "NODE_ENV=development node --watch server/server.js",
    "test": "mocha",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:reset": "npx sequelize-cli db:seed:undo:all && npx sequelize-cli db:seed:all",
    "lint": "eslint app server tests",
    "test:e2e": "playwright test",
    "test:visual": "scripts/visual-tests.sh",
    "test:coverage": "c8 --reporter=text-summary --reporter=html mocha",
    "build:demo": "vite build --mode demo && node scripts/demo-text-files.mjs"
  },
  "bugs": {
    "url": "https://github.com/JoeKarlsson/post-stream/issues"
  },
  "main": "server/server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoeKarlsson/post-stream"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.0",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/redux-logger": "^3.0.13",
    "@types/remarkable": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "c8": "12.0.0",
    "chai": "^6.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mocha": "^12.0.3",
    "sass": "^1.108.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "errorhandler": "^1.5.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "redux-logger": "^3.0.6",
    "remarkable": "^2.0.1",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
